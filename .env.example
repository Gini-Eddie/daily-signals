# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_google_cloud_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
DATABASE_URL="DATABASE_URL"

# Frontend: leave unset for the bundled Node server. For Vercel + Render:
# VITE_API_BASE_URL=https://daily-signals-api.onrender.com/api

# Backend only: choose a private random setup key before the first deployment.
# Required to claim the existing personal data when creating the first account.
# ACCOUNT_SETUP_KEY=replace-with-a-long-random-secret

# Node hosting: point DATA_DIR at a persistent disk directory.
# DATA_DIR=/var/data/daily-signals

# Python local development only, if no ACCOUNT_SETUP_KEY is configured:
# ALLOW_LOCAL_ACCOUNT_SETUP=1
